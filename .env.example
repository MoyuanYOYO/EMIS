# ============================================
# EMIS 环境变量示例
# 复制本文件为 .env 并填入你自己的值：
#   cp .env.example .env      (Linux / macOS)
#   copy .env.example .env    (Windows CMD)
# .env 已被 .gitignore 忽略，不会进入版本库。
# ============================================

# ---------- 数据库配置 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写你的MySQL密码
DB_NAME=edu_sys

# ---------- 应用配置 ----------
# 运行 `python generate_key.py` 可一键生成下面三个随机值
SECRET_KEY=请运行generate_key.py生成
ENCRYPTION_KEY=请运行generate_key.py生成
SALT_VALUE=请运行generate_key.py生成

# ---------- 运行配置（可选）----------
# 生产环境请保持 FLASK_DEBUG=0，避免调试器对外暴露
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
